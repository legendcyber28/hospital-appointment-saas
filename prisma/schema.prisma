// Hospital & Clinic Appointment SaaS - mini version
// Multi-tenant: every tenant table carries organizationId.
// SQLite for local demo; set DATABASE_URL to Postgres for production
// (change provider to "postgresql").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id                String   @id @default(cuid())
  name              String   @unique // STARTER, PRO, BUSINESS
  priceMonthly      Int      @default(0) // in paise (INR)
  maxDoctors        Int      @default(5)
  maxBranches       Int      @default(1)
  maxAppointmentsPm Int      @default(500)
  whatsappAi        Boolean  @default(false)
  analytics         Boolean  @default(false)
  createdAt         DateTime @default(now())
  organizations     Organization[]
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  type           String   @default("CLINIC") // HOSPITAL | CLINIC | DOCTOR_PRACTICE | DENTAL | DIAGNOSTIC | PHYSIOTHERAPY | OTHER
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String   @default("India")
  pincode        String?
  website        String?
  whatsappNumber String?
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED
  planId         String?
  plan           Plan?    @relation(fields: [planId], references: [id])
  subscriptionStatus String @default("TRIAL") // TRIAL | ACTIVE | EXPIRED
  createdAt      DateTime @default(now())
  branches       Branch[]
  users          User[]
  roles          Role[]
  departments    Department[]
  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  conversations  Conversation[]
  whatsappAccounts WhatsAppAccount[]
  auditLogs      AuditLog[]
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  isMain         Boolean @default(false)
  createdAt      DateTime @default(now())
  doctors        Doctor[]
  appointments   Appointment[]
}

model Role {
  id             String  @id @default(cuid())
  organizationId String? // null = platform-level role (SUPER_ADMIN)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // SUPER_ADMIN | ORGANIZATION_ADMIN | DOCTOR | RECEPTIONIST | custom...
  isSystem       Boolean @default(false)
  permissions    RolePermission[]
  users          UserRole[]
  @@unique([organizationId, name])
}

model Permission {
  key  String @id // DOCTOR_VIEW, APPOINTMENT_CREATE, ...
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  @@id([roleId, permissionKey])
}

model User {
  id             String  @id @default(cuid())
  organizationId String? // null = platform super admin
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String
  status         String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt      DateTime @default(now())
  roles          UserRole[]
  doctorProfile  Doctor?
  auditLogs      AuditLog[]
}

model UserRole {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  doctors        Doctor[]
  @@unique([organizationId, name])
}

model Doctor {
  id               String  @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  userId           String? @unique
  user             User?    @relation(fields: [userId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  name             String
  qualification    String?
  specialization   String?
  registrationNo   String?
  experienceYears  Int?
  consultFee       Int     @default(0) // in paise? use rupees for mini: rupees
  followUpFee      Int     @default(0)
  slotDurationMin  Int     @default(30)
  status           String  @default("ACTIVE") // ACTIVE | INACTIVE
  schedules        DoctorSchedule[]
  leaves           DoctorLeave[]
  appointments     Appointment[]
}

model DoctorSchedule {
  id        String @id @default(cuid())
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 0=Sunday .. 6=Saturday
  startTime String // "10:00"
  endTime   String // "13:00"
  breakStart String?
  breakEnd   String?
}

model DoctorLeave {
  id      String @id @default(cuid())
  doctorId String
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD
  reason  String?
  @@unique([doctorId, date])
}

model Patient {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  whatsappNumber String
  email          String?
  dob            String?
  gender         String?
  createdAt      DateTime @default(now())
  appointments   Appointment[]
  conversations  Conversation[]
  @@unique([organizationId, whatsappNumber])
}

model Appointment {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  date           String  // YYYY-MM-DD (org-local)
  startTime      String  // "10:30"
  endTime        String
  status         String  @default("PENDING") // PENDING | CONFIRMED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
  source         String  @default("STAFF")   // WHATSAPP | WEB | STAFF
  reason         String?
  createdAt      DateTime @default(now())
  @@index([organizationId, date])
  @@index([doctorId, date])
}

model Conversation {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])
  channel        String  @default("WHATSAPP_DEMO")
  mode           String  @default("AI") // AI | HUMAN
  state          String  @default("{}") // demo-AI state machine payload (JSON)
  status         String  @default("OPEN") // OPEN | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       ConversationMessage[]
}

model ConversationMessage {
  id             String  @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // PATIENT | AI | STAFF
  body           String
  createdAt      DateTime @default(now())
  @@index([conversationId, createdAt])
}

model WhatsAppAccount {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber    String
  displayName    String?
  mode           String  @default("DEMO") // DEMO | LIVE
}

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  resource       String
  resourceId     String?
  oldValue       String?
  newValue       String?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
}
